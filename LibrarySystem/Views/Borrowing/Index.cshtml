@model IEnumerable<LibrarySystem.Models.Borrowing>

@{
    ViewData["Title"] = "Borrowings";
}

<h1>Borrowings</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create New Borrowing
    </a>
</p>

<table class="table table-striped table-bordered">

    <thead>
        <tr>
            <th>Id</th>
            <th>Book</th>
            <th>Member</th>
            <th>Borrowing Date</th>
            <th>Due Date</th>
            <th>Return Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Book?.Title</td>
                <td>@item.Member?.FullName</td>
                <td>@item.BorrowingDate.ToString("yyyy-MM-dd")</td>
                <td>@item.DueDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @(item.ReturnDate?.ToString("yyyy-MM-dd") ?? "Not Returned")
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">Edit</a>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">Details</a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>

</table>
